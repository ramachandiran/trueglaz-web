{
  "expo": {
    "name": "TrueGlaz",
    "slug": "trueglaz",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": false,
    "splash": { "resizeMode": "contain", "backgroundColor": "#0d1117" },
    "ios": { "supportsTablet": true, "bundleIdentifier": "com.trueglaz.app" },
    "android": { "package": "com.trueglaz.app" },
    "web": { "bundler": "metro" },
    "extra": { "apiOrigin": "http://localhost:8080" }
  }
}
